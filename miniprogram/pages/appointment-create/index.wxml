<view class="container"><view class="heading">{{type==='first'?'预约首次采集':'申请再次采集'}}</view><view class="sub">项目工作时间：{{workdaysText}}，{{workdayStart}}–{{workdayEnd}}。提交后由项目管理员确认。</view><view class="card"><view class="label">期望日期</view><picker mode="date" bindchange="dateChange"><view class="field">{{date||'点击选择日期'}}</view></picker><view class="label">期望时间</view><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="field">{{time}}</view></picker><view class="label">备注</view><textarea class="field" placeholder="选填" bindinput="noteChange" maxlength="300"/><button class="primary profile-action" bindtap="submit">提交预约申请</button><view class="error">{{error}}</view></view></view>
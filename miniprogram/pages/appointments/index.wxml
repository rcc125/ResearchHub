<view class="container"><view class="heading">我的预约记录</view><view class="sub">查看首次采集和失败重约申请的审核进度。</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="heading">{{item.project_title}}</view><view class="item">预约类型：{{item.appointment_type==='first'?'首次采集':'重新采集'}}</view><view class="item">期望时间：{{item.requested_at}}</view><view class="item">状态：{{item.status==='pending'?'待审核':item.status==='confirmed'?'已确认':item.status==='rejected'?'已拒绝':item.status}}</view><view wx:if="{{item.confirmed_at}}" class="item">确认时间：{{item.confirmed_at}}</view><view class="muted">{{item.admin_note}}</view></view><view wx:if="{{!items.length}}" class="sub">暂无预约申请</view><view class="error">{{error}}</view></view>
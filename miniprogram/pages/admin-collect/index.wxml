<view class="container"><view class="heading">登记一次采集</view><view class="sub">{{projectTitle}} · {{subjectCode}} {{subjectName}}</view><view class="card"><view class="sub">{{appointmentHint}}</view><view class="label">采集结果</view><radio-group bindchange="chooseStatus"><label class="item"><radio value="success" checked="{{status==='success'}}"/>成功</label><label class="item"><radio value="failed" checked="{{status==='failed'}}"/>失败</label><label class="item"><radio value="aborted" checked="{{status==='aborted'}}"/>中止</label></radio-group><view class="label">实际采集日期</view><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="field">{{date||'选择日期'}}</view></picker><view class="label">实际采集时间</view><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="field">{{time}}</view></picker><view wx:if="{{status==='failed'}}"><view class="label">失败原因（必填）</view><textarea class="field" bindinput="reasonChange" maxlength="300"/></view><view class="label">科研数据关联编号（选填）</view><input class="field" bindinput="refChange" maxlength="120"/><button class="primary profile-action" bindtap="submit">保存本次采集</button><view class="error">{{error}}</view></view></view>
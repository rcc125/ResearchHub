<view class="container"><view class="heading">个人中心</view><view class="card"><view class="heading">{{profile ? (profile.name || '受试者') : '尚未登录'}}</view><view class="sub">{{profile ? ('受试者编号：'+profile.subject_code) : '请先登录并完善人口统计学信息'}}</view><button class="primary profile-action" bindtap="login">登录 / 切换账号</button></view><view class="card"><view class="heading">个人资料与记录</view><button class="primary profile-action" bindtap="profile">人口统计学信息</button><button class="primary profile-action" bindtap="collections">我的采集记录</button><button class="primary profile-action" bindtap="appointments">我的预约记录</button></view><view class="card"><view class="heading">科研管理</view><view class="sub">仅项目授权的科研成员可使用管理功能。</view><button class="primary profile-action" bindtap="admin">管理项目 / 采集与预约审核</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
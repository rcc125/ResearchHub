<view class="container"><view class="heading">科研管理工作台</view><view class="sub">仅项目科研成员可查看受试者资料。</view><button wx:if="{{demo}}" class="primary profile-action" bindtap="enable">启用本地演示管理员（仅测试）</button><view class="card"><view class="heading">我的管理项目</view><view wx:for="{{projects}}" wx:key="id" class="item" bindtap="changeProject" data-id="{{item.id}}">{{item.title}} · 负责人：{{item.leader_name}} <text wx:if="{{projectId===item.id}}">✔</text></view></view>
<view wx:if="{{projectId}}"><view class="card"><view class="heading">项目与预约设置</view><view class="label">项目负责人姓名</view><input class="field" value="{{leaderName}}" bindinput="leaderChange" placeholder="负责人姓名"/><view class="label">工作日（周一=1，周日=7，逗号分隔）</view><input class="field" value="{{workdays}}" bindinput="workdaysChange"/><view class="label">工作开始时间</view><picker mode="time" value="{{workdayStart}}" bindchange="startChange"><view class="field">{{workdayStart}}</view></picker><view class="label">工作结束时间</view><picker mode="time" value="{{workdayEnd}}" bindchange="endChange"><view class="field">{{workdayEnd}}</view></picker><button class="primary profile-action" bindtap="saveSettings">保存项目设置</button></view>
<view class="card"><view class="heading">受试者（{{subjects.length}}）</view><view wx:for="{{subjects}}" wx:key="enrollment_id" class="item"><view>{{item.subject_code}} · {{item.name}} · {{item.gender}} · {{item.age}} 岁</view><view class="muted">身高 {{item.height_cm}} cm / 体重 {{item.weight_kg}} kg</view><button class="primary wide-action" data-enrollment="{{item.enrollment_id}}" bindtap="collect">登记采集结果</button></view></view>
<view class="card"><view class="heading">近期采集（{{collections.length}}）</view><view wx:for="{{collections}}" wx:key="id" class="item clickable" data-item="{{item}}" bindtap="viewCollection">{{item.subject_code}} · {{item.collection_code}} · {{item.status}}<view class="muted">采集时间：{{item.collected_at}}</view><view class="muted">点击查看采集详情</view></view></view>
<view class="card"><view class="heading">预约审核（{{appointments.length}}）</view><view wx:for="{{appointments}}" wx:key="id" class="item clickable" data-item="{{item}}" bindtap="viewAppointment"><view>{{item.subject_code}} {{item.subject_name}} · {{item.requested_at}} · {{item.status}}</view><view class="muted">点击查看预约详情</view><button wx:if="{{item.status==='pending'}}" class="primary wide-action" data-id="{{item.id}}" catchtap="review">审核该预约</button></view></view><button class="primary profile-action" bindtap="exportExcel">导出当前项目 Excel</button></view><view class="error">{{error}}</view></view>
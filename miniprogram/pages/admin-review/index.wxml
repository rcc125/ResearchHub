<view class="container"><view class="heading">审核预约</view><view class="card"><view wx:if="{{appointment}}" class="sub">{{appointment.subject_code}} {{appointment.subject_name}} · {{appointment.appointment_type==='first'?'首次采集':'重新采集'}}</view><view class="label">预约期望时间</view><view class="field">{{appointment.requested_at}}</view><view class="label">确认日期（默认同步预约日期，可修改）</view><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="field">{{date||'选择日期'}}</view></picker><view class="label">确认时间</view><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="field">{{time}}</view></picker><view class="label">管理员备注</view><textarea class="field" bindinput="noteChange" maxlength="300"/><button class="primary profile-action" data-status="confirmed" bindtap="review">确认预约</button><button class="primary profile-action" data-status="rejected" bindtap="review">拒绝预约</button><view class="error">{{error}}</view></view></view>